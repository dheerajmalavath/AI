# ============================================================
# TripMate AI - Multi-Agent System Environment Variables
# ============================================================

# 1. GROQ API Key & Model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2500

# 2. Tavily API Key - Hotel & web search via MCP
TAVILY_API_KEY=your_tavily_api_key_here

# 3. OpenWeather API Key - Real-time weather data via MCP
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. AviationStack API Key - Flight/airport/airline info via MCP
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here

# 5. PostgreSQL Database URL - LangGraph HITL state persistence
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
